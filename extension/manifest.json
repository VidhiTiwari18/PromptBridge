{
  "manifest_version": 3,
  "name": "PromptBridge",
  "version": "1.0.0",
  "description": "Capture, summarize, and transfer AI chat context across platforms",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "http://localhost:3000/*"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-scripts/claude.js"]
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content-scripts/chatgpt.js"]
    }
  ]
}